{
  "name": "parley",
  "version": "0.1.0",
  "private": true,
  "description": "A protocol for programs that talk to agents. This package holds the repository's own checks; the spec and schemas are the product.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "check": "bun run scripts/check-examples.ts",
    "test": "bun test",
    "doctor": "bun run scripts/doctor.ts",
    "typecheck": "tsc -p packages/parley-emit/tsconfig.json"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bun-types": "^1.4.5",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
